# ============================================================
# MeowBot configuration - EVERYTHING is controlled from here.
# Copy this file to ".env" and fill in your own values.
# Never commit your real .env to git.
# ============================================================

# The bot's own phone number (digits only, with country code).
# Used for the pairing-code login on first run.
BOT_NUMBER=9725XXXXXXXX

# Bot owners (digits only, comma separated). Owners bypass
# authorization, cooldowns and group-admin checks.
OWNER_NUMBERS=9725XXXXXXXX

# Command prefix
PREFIX=!

# Bot language: he | en
# Every user-facing string is translated. There is an automated
# audit (npm run audit) that fails the build if a single Hebrew
# string leaks through while BOT_LANG=en.
BOT_LANG=he

# Access mode: self | authorized | public
#   self       - only owners can use the bot
#   authorized - owners + globally/group authorized users
#   public     - everyone can use general commands
BOT_MODE=authorized

# --- AI (Gemini) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model id, e.g. gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash
# The bot's name, used inside AI prompts
AI_NAME=MeowBot

# --- Behavior knobs ---
# React with an emoji after each handled command (v17 reaction logic)
REACTIONS_ENABLED=true
# Seconds between two commands from the same non-owner user
COOLDOWN_SECONDS=5
# Warnings before !warn auto-kicks (persisted in the DB)
WARN_LIMIT=3

# --- Privacy systems ---
# Forward messages deleted by others ("delete for everyone") to owners
ANTI_DELETE=true
# Include the media of deleted messages (downloads it first)
ANTI_DELETE_MEDIA=true
# Save view-once photos/videos and forward them to owners
SAVE_VIEW_ONCE=true

# --- Anti-link default ---
# delete_only | delete_kick | warn_delete
ANTILINK_DEFAULT_MODE=delete_only

# --- YouTube downloader ---
# Empty = auto-detect (Termux path, then PATH)
YT_DLP_PATH=
# opus | mp3
YT_AUDIO_FORMAT=opus
# Send downloads as voice notes (opus) or regular audio files
YT_VOICE_NOTE=true

# --- Stickers ---
STICKER_AUTHOR=MeowBot
STICKER_PACK=MeowBot

# --- Storage ---
AUTH_DIR=./auth
DB_FILE=./data.json
TEMP_DIR=./temp
